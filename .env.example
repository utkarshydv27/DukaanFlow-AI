# Copy this file to .env before configuring your own credentials.
# Never commit .env or share access tokens publicly.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_PATH=data/dukaanflow.db
SEED_DEMO_DATA=true
ENABLE_DEMO_TOOLS=true

# Protect the dashboard if you expose it beyond your own computer.
# Local-only demo can leave this blank. Set a strong password before deploying.
DASHBOARD_PASSWORD=

# WhatsApp Cloud API (Meta Developer dashboard)
WHATSAPP_VERIFY_TOKEN=replace-with-your-own-random-webhook-verification-token
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SEND_CONFIRMATIONS=false
META_GRAPH_VERSION=v26.0

# Local AI via Ollama improves interpretation of varied Hinglish, Roman Hindi, and Hindi.
# If Ollama is unavailable, conservative rule-based classification is used. Enable/disable as needed.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=12
